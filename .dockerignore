# Keep the build context small and never ship secrets or local state into
# the image. The Dockerfile copies only what it needs (src, alembic,
# frontend), so nothing sensitive is baked in even by accident.
.git
.github
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
node_modules
frontend/node_modules
frontend/dist
*.db
.console_key*
*.env
!*.env.example
.DS_Store
docs
tests
*.md
compose*.yaml
